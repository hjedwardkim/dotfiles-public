#!/usr/bin/env bash
# Forks the Claude session in the focused herdr pane into a new tab of the same workspace.
set -euo pipefail

fail() {
  herdr notification show "fork-claude" --body "$1" >/dev/null 2>&1 || true
  echo "$1" >&2
  exit 1
}

pane=$(herdr pane list | jq -c '[.result.panes[] | select(.focused)][0] // empty')
[[ -n $pane ]] || fail "no focused pane"
[[ $(jq -r '.agent' <<<"$pane") == claude ]] || fail "focused pane is not running claude"

session=$(jq -r '.agent_session.value // empty' <<<"$pane")
[[ -n $session ]] || fail "herdr has no session id for the focused claude pane"
ws=$(jq -r '.workspace_id' <<<"$pane")
cwd=$(jq -r '.foreground_cwd // .cwd' <<<"$pane")

root=$(herdr tab create --workspace "$ws" --cwd "$cwd" --focus | jq -r '.result.root_pane.pane_id')
herdr pane run "$root" "claude -r $session --fork-session" >/dev/null
